{
  "schemaVersion": 1,
  "name": "oh-my-musecode",
  "displayName": "Oh My Muse Code",
  "version": "0.1.1",
  "description": "Productivity layer for Meta Muse Code: skills, slash-commands, hooks, and .omm session state.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "architect",
        "path": "skills/architect/SKILL.md"
      },
      {
        "id": "planner",
        "path": "skills/planner/SKILL.md"
      },
      {
        "id": "executor",
        "path": "skills/executor/SKILL.md"
      },
      {
        "id": "explore",
        "path": "skills/explore/SKILL.md"
      },
      {
        "id": "analyst",
        "path": "skills/analyst/SKILL.md"
      },
      {
        "id": "designer",
        "path": "skills/designer/SKILL.md"
      },
      {
        "id": "debugger",
        "path": "skills/debugger/SKILL.md"
      },
      {
        "id": "tracer",
        "path": "skills/tracer/SKILL.md"
      },
      {
        "id": "critic",
        "path": "skills/critic/SKILL.md"
      },
      {
        "id": "code-reviewer",
        "path": "skills/code-reviewer/SKILL.md"
      },
      {
        "id": "security-reviewer",
        "path": "skills/security-reviewer/SKILL.md"
      },
      {
        "id": "code-simplifier",
        "path": "skills/code-simplifier/SKILL.md"
      },
      {
        "id": "test-engineer",
        "path": "skills/test-engineer/SKILL.md"
      },
      {
        "id": "qa-tester",
        "path": "skills/qa-tester/SKILL.md"
      },
      {
        "id": "verifier",
        "path": "skills/verifier/SKILL.md"
      },
      {
        "id": "scientist",
        "path": "skills/scientist/SKILL.md"
      },
      {
        "id": "document-specialist",
        "path": "skills/document-specialist/SKILL.md"
      },
      {
        "id": "writer",
        "path": "skills/writer/SKILL.md"
      },
      {
        "id": "git-master",
        "path": "skills/git-master/SKILL.md"
      }
    ],
    "commands": [
      {
        "id": "team",
        "path": "commands/team.md"
      },
      {
        "id": "autopilot",
        "path": "commands/autopilot.md"
      },
      {
        "id": "execute",
        "path": "commands/execute.md"
      },
      {
        "id": "ralph",
        "path": "commands/ralph.md"
      },
      {
        "id": "ralplan",
        "path": "commands/ralplan.md"
      },
      {
        "id": "deep-interview",
        "path": "commands/deep-interview.md"
      },
      {
        "id": "ask",
        "path": "commands/ask.md"
      },
      {
        "id": "verify",
        "path": "commands/verify.md"
      },
      {
        "id": "ultragoal",
        "path": "commands/ultragoal.md"
      },
      {
        "id": "handoff",
        "path": "commands/handoff.md"
      },
      {
        "id": "skillify",
        "path": "commands/skillify.md"
      },
      {
        "id": "omm-skill",
        "path": "commands/omm-skill.md"
      },
      {
        "id": "hud",
        "path": "commands/hud.md"
      },
      {
        "id": "omm-setup",
        "path": "commands/omm-setup.md"
      },
      {
        "id": "omm-doctor",
        "path": "commands/omm-doctor.md"
      },
      {
        "id": "remember",
        "path": "commands/remember.md"
      },
      {
        "id": "omm-trace",
        "path": "commands/omm-trace.md"
      },
      {
        "id": "wiki",
        "path": "commands/wiki.md"
      },
      {
        "id": "debug",
        "path": "commands/debug.md"
      }
    ],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "python3",
          "hooks/session_start.py"
        ],
        "timeoutMs": 5000,
        "statusMessage": "omm session start"
      },
      {
        "id": "prompt-keywords",
        "event": "UserPromptSubmit",
        "command": [
          "python3",
          "hooks/user_prompt.py"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "skill-gate",
        "event": "PreToolUse",
        "command": [
          "python3",
          "hooks/skill_gate.py"
        ],
        "timeoutMs": 8000
      },
      {
        "id": "stop-chain",
        "event": "Stop",
        "command": [
          "python3",
          "hooks/stop_chain.py"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "subagent-start",
        "event": "SubagentStart",
        "command": [
          "python3",
          "hooks/subagent_start.py"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "subagent-stop",
        "event": "SubagentStop",
        "command": [
          "python3",
          "hooks/subagent_stop.py"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "pre-compact",
        "event": "PreCompact",
        "command": [
          "python3",
          "hooks/pre_compact.py"
        ],
        "timeoutMs": 5000
      },
      {
        "id": "session-end",
        "event": "SessionEnd",
        "command": [
          "python3",
          "hooks/session_end.py"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
